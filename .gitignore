# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Ignore objects files
objs/

# Ignore binary files created at last
bin/

# Ignore temp files
temp/

# Ignore binary
run-g
run

# Ignore GNUmakefile, as configure.sh will generate it each time
# make search files in order: GNUmakefile --> makefile --> Makefile
GNUmakefile

# Ignore a build folder (for CMake)
build/

# Ignore cache files created by clangd (conducted by coc-nvim from VIM)
.cache/
.clangd/

# Ignore compiled database
compile_commands.json

# Ignore any CMake build tree (build/, build2/, build/<preset>/, ...)
build*/

# Machine-local CMake presets must never enter either remote repository
CMakeUserPresets.json

# Python extension modules and MinGW import libraries produced by CMake
*.pyd
*.dll.a

# IDE / package-manager scratch directories
out/
cmake-build-*/
.vs/
_deps/

# WorkBuddy project-local data (session notes, not source)
.workbuddy/
